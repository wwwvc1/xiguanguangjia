/* ============================================================
 * 成就 achievements 页面(I 方案)
 * ============================================================ */

.progress-card{
  margin: 24rpx 32rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  background: linear-gradient(140deg, var(--agar), var(--agar-2));
  color: var(--paper);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--agar);
  box-shadow: 0 16rpx 32rpx rgba(20, 42, 32, 0.25);
}
.progress-row{
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.progress-num{
  font-size: 72rpx;
  font-weight: 700;
  color: var(--paper);
  letter-spacing: -0.04em;
}
.progress-total{
  font-size: 36rpx;
  color: var(--bone);
  font-weight: 700;
}
.progress-label{
  font-size: 26rpx;
  color: var(--bone);
  display: block;
  margin-bottom: 24rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.progress-bar{
  height: 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.20);
  overflow: hidden;
}
.progress-fill{
  height: 100%;
  background: var(--bone);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.achievement-grid{
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 32rpx;
}

.ach-card{
  padding: 32rpx 24rpx;
  text-align: center;
  transition: all 0.2s;
  border-radius: var(--r-md);
}
.ach-card.locked{
  opacity: 0.45;
  filter: grayscale(0.6);
}
.ach-card.unlocked{
  opacity: 1;
  background: var(--bone);
  border-color: rgba(20, 42, 32, 0.18);
}

.ach-icon{
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}
.ach-name{
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: -0.01em;
}
.ach-desc{
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.5;
  display: block;
  min-height: 60rpx;
  font-weight: 500;
}
.ach-time{
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--agar);
  font-weight: 700;
  letter-spacing: 0.04em;
}
.ach-locked-hint{
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  font-weight: 500;
}