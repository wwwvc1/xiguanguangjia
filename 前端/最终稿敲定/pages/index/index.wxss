/* ============================================================
 * 首页 index 特有样式(基于 I 方案)
 * ============================================================ */

/* ===== 用户招呼(顶部小型条) ===== */
.greeting{
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}
.greeting-hi{
  font-size: 30rpx;
  color: var(--ink-2);
  font-weight: 600;
  letter-spacing: -0.005em;
}
.greeting-name{
  font-family: 'Georgia','Times New Roman','Noto Serif CJK SC',serif;
  font-style: italic;
  color: var(--ink);
  font-weight: 700;
  font-size: 36rpx;
  letter-spacing: -0.01em;
}
.greeting-date{
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 500;
  letter-spacing: 0.02em;
}

/* ===== 连续打卡 hero(放大版,沉香绿渐变 + 米骨散光,移到页面底部) ===== */
.streak-hero{
  margin: 32rpx 0 0;
  padding: 32rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(140deg, var(--agar), var(--agar-2));
  border: 1rpx solid rgba(20, 42, 32, 0.30);
  border-radius: var(--r-lg);
  box-shadow: 0 16rpx 32rpx rgba(20, 42, 32, 0.25);
  position: relative;
  overflow: hidden;
}
.streak-hero::after{
  content: "";
  position: absolute;
  right: -30rpx;
  bottom: -30rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 201, 165, 0.35), transparent 70%);
  pointer-events: none;
}
.streak-hero-flame{
  font-size: 72rpx;
  line-height: 1;
  flex-shrink: 0;
}
.streak-hero-info{
  flex: 1;
  min-width: 0;
  color: var(--paper);
}
.streak-hero-num-row{
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.streak-hero-num{
  font-size: 120rpx;
  font-weight: 800;
  color: var(--paper);
  line-height: 1;
  letter-spacing: -0.04em;
  font-style: italic;
}
.streak-hero-unit{
  font-size: 36rpx;
  font-weight: 700;
  color: var(--bone);
  line-height: 1;
  font-style: italic;
}
.streak-hero-label{
  font-size: 24rpx;
  font-weight: 600;
  color: var(--bone);
  margin-top: 8rpx;
  letter-spacing: 0.04em;
}
.streak-hero-status{
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  flex-shrink: 0;
  border: 2rpx solid rgba(216, 201, 165, 0.40);
}
.streak-hero-status.done{
  background: var(--bone);
  color: var(--agar);
}
.streak-hero-status.pending{
  background: rgba(255, 255, 255, 0.18);
  color: var(--bone);
}

/* ===== 数据卡片(放大版,3 列大数字,拉长) ===== */
.data-cards{
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 32rpx;
}
.data-card{
  background: rgba(251, 250, 246, 0.55);
  backdrop-filter: blur(24rpx) saturate(180%);
  -webkit-backdrop-filter: blur(24rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  border-radius: var(--r-md);
  padding: 36rpx 12rpx 26rpx;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(20, 42, 32, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
  position: relative;
  overflow: hidden;
  min-height: 180rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.data-card::before{
  content: "";
  position: absolute;
  top: 0;
  left: 14rpx;
  right: 14rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.95), transparent);
  pointer-events: none;
}
.data-card-label{
  font-size: 22rpx;
  color: var(--ink-3);
  margin-bottom: 8rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.data-card-value-row{
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2rpx;
  margin-bottom: 4rpx;
}
.data-card-currency{
  font-size: 28rpx;
  font-weight: 700;
  color: var(--agar);
  align-self: flex-start;
  margin-top: 4rpx;
}
.data-card-value{
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.data-card-value.primary-dark{ color: var(--agar); }
.data-card-value.warn{ color: var(--brick); }
.data-card-unit{
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-3);
  margin-left: 2rpx;
}
.data-card-sub{
  font-size: 20rpx;
  color: var(--ink-3);
  font-weight: 500;
  letter-spacing: 0.02em;
}

/* ===== AI 智能建议 hero(沉香绿大卡,与 streak-hero 同款) ===== */
.insight-hero{
  margin: 0 0 28rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(140deg, var(--agar), var(--agar-2));
  border: 1rpx solid rgba(20, 42, 32, 0.30);
  border-radius: var(--r-lg);
  box-shadow: 0 14rpx 28rpx rgba(20, 42, 32, 0.22);
  position: relative;
  overflow: hidden;
  color: var(--paper);
}
.insight-hero::after{
  content: "";
  position: absolute;
  right: -40rpx;
  top: -30rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 201, 165, 0.30), transparent 70%);
  pointer-events: none;
}
.insight-hero-label{
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.insight-hero-emoji{
  font-size: 32rpx;
  line-height: 1;
}
.insight-hero-title{
  font-size: 28rpx;
  font-weight: 700;
  color: var(--paper);
  letter-spacing: -0.01em;
  flex: 1;
}
.insight-hero-more{
  font-size: 22rpx;
  font-weight: 600;
  color: var(--bone);
  letter-spacing: 0.04em;
}
.insight-hero-body{
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--paper);
  letter-spacing: -0.005em;
  font-weight: 500;
  padding-right: 80rpx;
}
.insight-hero-body.muted{
  color: var(--bone);
  font-style: italic;
}

/* ===== 今日结余长显示卡(I 方案) ===== */
.finance-card{
  padding: 36rpx 32rpx;
  margin-bottom: 32rpx;
}
.finance-stats{
  display: flex;
  justify-content: space-around;
  gap: 12rpx;
}
.finance-stats .item{
  text-align: center;
  flex: 1;
  padding: 8rpx 4rpx;
  border-right: 1rpx solid var(--line-2);
}
.finance-stats .item:last-child{ border-right: none; }
.finance-stats .num{
  font-size: 52rpx;
  font-weight: 700;
  display: block;
  letter-spacing: -0.03em;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  font-style: italic;
}
.finance-stats .num.in{ color: var(--agar); }
.finance-stats .num.out{ color: var(--brick); }
.finance-stats .label{
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
  display: block;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

/* ===== 连续打卡(首页内嵌版) ===== */
.checkin-card{
  margin-bottom: 32rpx;
  padding: 32rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, var(--agar-soft-2), var(--bone));
  border: 1rpx solid rgba(20, 42, 32, 0.18);
  border-radius: var(--r-lg);
}
.checkin-flame{
  font-size: 56rpx;
  line-height: 1;
}
.checkin-info{
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex: 1;
}
.checkin-num{
  font-size: 60rpx;
  font-weight: 800;
  color: var(--agar);
  line-height: 1;
  letter-spacing: -0.03em;
}
.checkin-unit{
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 700;
}
.checkin-status{
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
}
.checkin-status.done{
  background: var(--agar);
  color: var(--paper);
}
.checkin-status.pending{
  background: var(--paper-2);
  color: var(--ink-3);
}

.missed-hint{
  font-size: 24rpx;
  color: var(--brick);
  margin: -16rpx 12rpx 24rpx;
  padding: 0 12rpx;
  font-weight: 600;
}

/* ===== 今日饮食摘要 ===== */
.diet-summary{
  padding: 32rpx;
  text-align: center;
  margin-bottom: 32rpx;
}
.diet-summary .deco{
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
  opacity: 0.4;
}
.diet-summary .cal-big{
  font-size: 64rpx;
  font-weight: 700;
  color: var(--brick);
  display: block;
  letter-spacing: -0.03em;
}
.diet-summary .cal-label{
  font-size: 24rpx;
  color: var(--ink-3);
  display: block;
  margin-top: 8rpx;
  font-weight: 600;
}

/* ===== 今日交易弹窗 ===== */
.modal-mask{
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 26, 20, 0.40);
  backdrop-filter: blur(4rpx);
  -webkit-backdrop-filter: blur(4rpx);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-content{
  width: 600rpx;
  padding: 40rpx 32rpx;
  margin: 0 32rpx;
}
.modal-title{
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
  letter-spacing: -0.01em;
}
.today-tx-list{
  max-height: 500rpx;
  overflow-y: auto;
}
.today-tx-item{
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--line-2);
}
.today-tx-item:last-child{ border-bottom: none; }
.today-tx-info{ flex: 1; }
.today-tx-info .title{
  font-size: 28rpx;
  color: var(--ink);
  display: block;
  font-weight: 600;
}
.today-tx-info .desc{
  font-size: 22rpx;
  color: var(--ink-3);
  display: block;
  margin-top: 4rpx;
  font-weight: 500;
}
.today-tx-item .amount{
  font-size: 28rpx;
  font-weight: 700;
}
.today-tx-item .amount.income{ color: var(--agar); }
.today-tx-item .amount.expense{ color: var(--brick); }

.modal-actions{
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.modal-btn{
  flex: 1;
  padding: 24rpx;
  border-radius: var(--r-lg);
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}
.cancel-btn{
  background: var(--paper-2);
  color: var(--ink-2);
  border: 1rpx solid var(--line-2);
}
.confirm-btn{
  color: var(--paper);
  background: var(--agar);
  box-shadow: 0 6rpx 16rpx rgba(20, 42, 32, 0.20), inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

/* ===== AI 建议卡 ===== */
.insight-card{
  margin: 0 0 32rpx;
  padding: 24rpx 28rpx;
}
.insight-card.tinted{
  background: var(--bone);
  border-color: rgba(20, 42, 32, 0.20);
}
.insight-text{
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.6;
  display: block;
  font-weight: 500;
}
.insight-text.muted{ color: var(--ink-3); }

