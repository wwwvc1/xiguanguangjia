/* ============================================================
 * 每日打卡 checkin 页面(I 方案)
 * ============================================================ */

.container{
  min-height: 100vh;
  background: transparent;
}

/* ===== 连续天数 hero(深绿渐变 + 米骨散光) ===== */
.streak-hero{
  margin: 0 32rpx 24rpx;
  padding: 40rpx 40rpx 36rpx;
  background: linear-gradient(140deg, var(--agar), var(--agar-2));
  border: 1rpx solid var(--agar);
  border-radius: var(--r-lg);
  color: var(--paper);
  box-shadow: 0 16rpx 32rpx rgba(20, 42, 32, 0.28);
  position: relative;
  overflow: hidden;
}
.streak-hero::after{
  content: "";
  position: absolute;
  right: -30rpx;
  bottom: -30rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 201, 165, 0.32), transparent 70%);
  pointer-events: none;
}
.streak-roman{
  font-family: Georgia, 'Times New Roman', 'Noto Serif CJK SC', serif;
  font-size: 44rpx;
  font-style: italic;
  font-weight: 500;
  color: var(--bone);
  letter-spacing: 0.04em;
  line-height: 1;
  margin-bottom: 14rpx;
}
.streak-num-row{
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.streak-num{
  font-family: Georgia, 'Times New Roman', 'Noto Serif CJK SC', serif;
  font-size: 120rpx;
  font-weight: 500;
  color: var(--paper);
  line-height: 1;
  letter-spacing: -0.04em;
  font-variant-numeric: tabular-nums;
}
.streak-unit{
  font-family: Georgia, 'Times New Roman', 'Noto Serif CJK SC', serif;
  font-size: 36rpx;
  font-style: italic;
  font-weight: 500;
  color: var(--bone);
  letter-spacing: 0.02em;
}
.streak-mark{
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 6rpx 16rpx;
  border-radius: var(--r-pill);
  border: 1rpx solid rgba(216, 201, 165, 0.40);
}
.streak-mark.done{
  background: var(--bone);
  color: var(--agar);
}
.streak-mark.pending{
  background: rgba(255, 255, 255, 0.18);
  color: var(--bone);
}

/* ===== 今日状态按钮 ===== */
.checkin-action{
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}
.checkin-btn{
  width: 100%;
  padding: 28rpx;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--paper);
  background: var(--agar);
  box-shadow: 0 8rpx 22rpx rgba(20, 42, 32, 0.32), inset 0 1rpx 0 rgba(255, 255, 255, 0.20);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  line-height: 1.2;
  text-align: center;
}
.checkin-btn.done{
  background: var(--agar);
  color: var(--paper);
  box-shadow: 0 6rpx 18rpx rgba(20, 42, 32, 0.30), inset 0 1rpx 0 rgba(216, 201, 165, 0.25);
  opacity: 0.92;
  cursor: default;
}
.checkin-btn:active:not(.done){
  transform: scale(0.98);
}

/* ===== 备注输入(仅未打卡) ===== */
.note-section{ padding: 0 32rpx 24rpx; }
.note-label{
  font-size: 22rpx;
  color: var(--ink-3);
  display: block;
  margin-bottom: 12rpx;
  font-weight: 700;
  letter-spacing: 0.20em;
  text-transform: uppercase;
}
.note-input{
  width: 100%;
  min-height: 96rpx;
  max-height: 200rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
  background: rgba(248, 245, 238, 0.55);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.6;
  box-sizing: border-box;
  font-family: inherit;
}

/* ===== 标题 ===== */
.section-title{
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 24rpx 12rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.01em;
}
.section-title .brick-italic{
  font-family: Georgia, 'Times New Roman', serif;
  color: var(--brick);
  font-style: italic;
  font-size: 36rpx;
  font-weight: 600;
}
.section-count{
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

/* ===== 30 天日历(7 列网格) ===== */
.cal-grid{
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  padding: 8rpx 32rpx 24rpx;
}
.cal-day{
  position: relative;
  aspect-ratio: 1;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border: 1rpx solid var(--line-2);
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  transition: all 0.2s ease;
}
.cal-day.checked{
  background: var(--agar);
  border-color: var(--agar);
  color: var(--paper);
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(20, 42, 32, 0.18);
}
.cal-day.today{
  outline: 2rpx solid var(--brick);
  outline-offset: -2rpx;
  color: var(--ink);
  font-weight: 700;
  background: var(--paper-2);
}
.cal-day.today.checked{
  outline-color: var(--gold);
  background: var(--agar);
  color: var(--paper);
}
.cal-day-num{
  font-size: 22rpx;
  line-height: 1;
}
.cal-day-tick{
  position: absolute;
  top: 2rpx;
  right: 4rpx;
  font-size: 16rpx;
  line-height: 1;
  color: var(--bone);
  font-weight: 700;
}

/* ===== 历史记录 ===== */
.history-list{
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.history-item{
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.history-date{
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 700;
  min-width: 140rpx;
  letter-spacing: -0.005em;
  font-variant-numeric: tabular-nums;
}
.history-note{
  font-size: 26rpx;
  color: var(--ink-2);
  flex: 1;
  font-weight: 500;
}
.history-note.empty{
  color: var(--ink-3);
  font-style: italic;
}