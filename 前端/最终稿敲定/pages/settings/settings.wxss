/* ============================================================
 * 设置 settings 页面(I 方案)
 * ============================================================ */

/* AI 头像缩略图 */
.icon-pit.avatar-mini{
  overflow: hidden;
  padding: 0;
}
.avatar-thumb{
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: block;
}

/* 双行文字 */
.setting-item .text-col{
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.setting-item .text-sub{
  font-size: 24rpx;
  color: var(--ink-3);
  font-weight: 500;
}

/* 右侧行内:switch + 删除 */
.setting-item .right{
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 数字输入框 */
.number-input{
  width: 120rpx;
  height: 56rpx;
  background: var(--paper-2);
  border-radius: var(--r-sm);
  border: 1rpx solid var(--line-2);
  text-align: center;
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 700;
  padding: 0 8rpx;
}
.setting-item .right .action-btn{
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--ink-3);
  flex-shrink: 0;
  background: var(--paper-2);
  border: 1rpx solid var(--line-2);
}
.setting-item .right .action-btn:active{
  background: var(--paper-3);
}

/* 添加入口 */
.setting-item.add-item .icon-pit{
  background: var(--agar-soft-2);
  color: var(--agar);
  font-size: 40rpx;
  font-weight: 700;
  border: 1rpx solid rgba(20, 42, 32, 0.20);
}

/* ===== 弹窗 ===== */
.modal-mask{
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 26, 20, 0.40);
  backdrop-filter: blur(4rpx);
  -webkit-backdrop-filter: blur(4rpx);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-content{
  width: 620rpx;
  padding: 40rpx 32rpx;
  margin: 0 32rpx;
}
.modal-title{
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
  letter-spacing: -0.01em;
}

/* 表单 */
.form-label{
  display: block;
  font-size: 28rpx;
  color: var(--ink-2);
  margin-bottom: 16rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.weekday-section{
  margin-top: 24rpx;
  padding: 0 4rpx;
}
.weekday-row{
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}
.weekday-chip{
  position: relative;
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-sm);
  background: #FBFAF6;
  border: 1.5rpx solid var(--line-2);
  font-size: 30rpx;
  color: var(--ink-2);
  font-weight: 600;
  transition: all 0.15s ease;
}
.weekday-chip:active{
  transform: scale(0.96);
}
.weekday-chip.active{
  background: var(--agar) !important;
  border-color: var(--agar) !important;
  color: #FBFAF6 !important;
  font-weight: 700;
  transform: scale(1.05);
  box-shadow:
    0 6rpx 18rpx rgba(20, 42, 32, 0.35),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.22);
}
.weekday-chip .weekday-text{
  font-size: 30rpx;
  line-height: 1;
}
.weekday-chip.active .weekday-text{
  font-weight: 700;
  color: #FBFAF6;
}
.weekday-chip .weekday-tick{
  position: absolute;
  top: 4rpx;
  right: 6rpx;
  font-size: 18rpx;
  color: var(--bone);
  font-weight: 700;
  line-height: 1;
}

.type-row{
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.type-chip{
  padding: 14rpx 22rpx;
  border-radius: var(--r-md);
  font-size: 26rpx;
  color: var(--ink-2);
  background: rgba(248, 245, 238, 0.65);
  border: 1rpx solid var(--line-2);
  transition: all 0.2s ease;
  font-weight: 600;
}
.type-chip.active{
  color: var(--paper);
  background: var(--agar);
  border-color: var(--agar);
  box-shadow: 0 4rpx 10rpx rgba(20, 42, 32, 0.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

.form-input{ padding: 4rpx; }
.form-input .modal-input{
  padding: 28rpx 28rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: rgba(248, 245, 238, 0.62);
  backdrop-filter: blur(20rpx) saturate(160%);
  -webkit-backdrop-filter: blur(20rpx) saturate(160%);
  border-radius: var(--r-md);
  border: 1rpx solid var(--line);
  width: 100%;
  box-sizing: border-box;
  font-weight: 500;
  min-height: 88rpx;
  line-height: 1.4;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.60);
}
.form-input .modal-input::placeholder{
  color: var(--ink-2);
  font-weight: 500;
}

.modal-actions{
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.modal-btn{
  flex: 1;
  padding: 24rpx;
  border-radius: var(--r-lg);
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}
.cancel-btn{
  background: var(--paper-2);
  color: var(--ink-2);
  border: 1rpx solid var(--line-2);
}
.confirm-btn{
  color: var(--paper);
  background: var(--agar);
  box-shadow: 0 6rpx 16rpx rgba(20, 42, 32, 0.20), inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}