/* ============================================================
 * 待办与目标 todo 页面(I 方案)
 * ============================================================ */

/* 顶部批量管理工具栏 */
.batch-toolbar{
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding: 8rpx 24rpx 4rpx;
  background: transparent;
  flex-shrink: 0;
}
.batch-btn{
  padding: 14rpx 28rpx;
  border-radius: var(--r-pill);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-2);
  background: var(--surface-glass);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border: 1rpx solid var(--line);
  white-space: nowrap;
}
.batch-btn:active{
  background: var(--paper-2);
}
.batch-btn.delete-btn{
  color: var(--brick);
  border-color: rgba(142, 61, 42, 0.20);
}

.todo-summary{
  font-size: 32rpx;
  color: var(--ink);
  margin: 0 12rpx 28rpx;
  font-weight: 400;
  letter-spacing: -0.01em;
}
.todo-summary .highlight{
  color: var(--agar);
  font-weight: 700;
  font-size: 40rpx;
}
.todo-summary .italic,
.todo-summary .highlight.italic{
  font-style: italic;
}
.todo-summary .highlight.italic{
  color: var(--brick);
}

/* 衬线强调(用于 Things To Do 之类) */
.serif{
  font-family: 'Georgia', 'Times New Roman', 'Noto Serif CJK SC', serif;
  letter-spacing: -0.02em;
}
.serif-italic{
  font-family: 'Georgia', 'Times New Roman', 'Noto Serif CJK SC', serif;
  font-style: italic;
  font-weight: 500;
}

/* 目标卡 */
.goal-card{
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  position: relative;
  transition: all 0.2s ease;
  border-left: 4rpx solid var(--agar);
}
.goal-card.selected{
  background: var(--brick-soft);
  border-left-color: var(--brick);
}
.goal-check{
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  background: var(--surface);
  border: 1rpx solid var(--line);
  z-index: 2;
  color: transparent;
}
.goal-check.checked{
  background: var(--agar);
  color: var(--paper);
  border-color: var(--agar);
}
.goal-content{
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.goal-card .goal-name{
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 8rpx;
  letter-spacing: -0.01em;
}
.goal-card .progress-wrap{
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.goal-card .progress-text{
  font-size: 26rpx;
  font-weight: 700;
  color: var(--agar);
  min-width: 80rpx;
  text-align: right;
}
.goal-card .progress-text.done{
  color: var(--brick);
}
.goal-card .update-time{
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
  font-weight: 500;
}
.goal-actions{
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

/* ===== 弹窗 ===== */
.modal-mask{
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 26, 20, 0.40);
  backdrop-filter: blur(4rpx);
  -webkit-backdrop-filter: blur(4rpx);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-content{
  width: 600rpx;
  padding: 40rpx 32rpx;
  margin: 0 32rpx;
}
.modal-title{
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
  letter-spacing: -0.01em;
}
.form-input{ padding: 4rpx; }
.form-input .modal-input{
  padding: 28rpx 28rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: rgba(248, 245, 238, 0.62);
  backdrop-filter: blur(20rpx) saturate(160%);
  -webkit-backdrop-filter: blur(20rpx) saturate(160%);
  border-radius: var(--r-md);
  border: 1rpx solid var(--line);
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  line-height: 1.4;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.60);
}
.form-input .modal-input::placeholder{
  color: var(--ink-2);
  font-weight: 500;
}

.form-row{
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.form-half{ flex: 1; }
.type-toggle{
  display: flex;
  gap: 12rpx;
}
.type-btn{
  padding: 16rpx 28rpx;
  border-radius: var(--r-md);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-3);
  background: var(--paper-2);
  border: 1rpx solid var(--line-2);
  transition: all 0.2s ease;
}
.type-btn.active{
  color: var(--paper);
  background: var(--agar);
  border-color: var(--agar);
}

.modal-actions{
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.modal-btn{
  flex: 1;
  padding: 24rpx;
  border-radius: var(--r-lg);
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}
.cancel-btn{
  background: var(--paper-2);
  color: var(--ink-2);
  border: 1rpx solid var(--line-2);
}
.confirm-btn{
  color: var(--paper);
  background: var(--agar);
  box-shadow: 0 6rpx 16rpx rgba(20, 42, 32, 0.20), inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

/* 日期选择器 */
.date-label{
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 12rpx;
  font-weight: 600;
}
.date-row{
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.date-picker{
  flex: 1;
  padding: 12rpx 16rpx;
  border-radius: var(--r-sm);
  background: var(--paper-2);
  border: 1rpx solid var(--line-2);
  font-size: 26rpx;
  color: var(--ink);
  text-align: center;
  font-weight: 500;
}
.date-sep{
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 700;
}

/* 目标时间段 */
.goal-period{
  font-size: 22rpx;
  color: var(--ink-3);
  margin: 6rpx 0 12rpx;
  font-weight: 500;
}