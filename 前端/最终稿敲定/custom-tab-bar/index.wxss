/* ============================================================
 * 自定义 TabBar - I 方案:悬浮胶囊浮层
 * ============================================================ */

.tab-bar-wrapper{
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  background: transparent;
  z-index: 100;
  pointer-events: none;
}
.tab-bar{
  width: 680rpx;
  max-width: calc(100vw - 64rpx);
  height: 110rpx;
  border-radius: 55rpx;
  display: flex;
  align-items: center;
  padding: 12rpx;
  gap: 8rpx;
  background: rgba(248, 245, 238, 0.62);
  backdrop-filter: blur(32rpx) saturate(180%);
  -webkit-backdrop-filter: blur(32rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow:
    0 14rpx 40rpx rgba(20, 42, 32, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
  pointer-events: auto;
}
.tab-item{
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 86rpx;
  border-radius: 43rpx;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.tab-item .icon{
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink-3);
  line-height: 1.1;
}
.tab-item .label{
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink-3);
  letter-spacing: 0.06em;
}
.tab-item.active{
  background: linear-gradient(140deg, var(--agar), var(--agar-2));
  box-shadow:
    0 8rpx 20rpx rgba(20, 42, 32, 0.40),
    inset 0 2rpx 0 rgba(216, 201, 165, 0.30);
}
.tab-item.active .icon,
.tab-item.active .label{
  color: var(--paper);
  font-weight: 700;
}