# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=habit_tracker

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# LLM 服务配置 — 系统默认模型
# 推荐:DeepSeek(便宜、中文好)
# 1. 去 https://platform.deepseek.com 申请 API key
# 2. 把下面的 sk-... 换成你的真实 key
# 3. 重启后端
OPENAI_BASE_URL=你的中转站base_url(例:https://apihub.agnes-ai.com/v1)
OPENAI_API_KEY=sk-你的key
CHAT_MODEL=你的模型名

# ChromaDB 持久化路径
CHROMA_DB_PATH=./chroma_db

# 微信小程序(可选,真实微信登录需要)
WX_APPID=your-wx-appid
WX_SECRET=your-wx-secret
