# ===================== 数据库 =====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=habit_tracker

# 连接池(可选,有默认值)
# DB_POOL_MIN=2
# DB_POOL_MAX=20
# DB_SYNC_POOL_MIN=2
# DB_SYNC_POOL_MAX=12

# ===================== JWT =====================
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# ===================== LLM =====================
# 系统默认模型;也可以在管理后台「AI 模型管理」里配置(优先用库里的)
# 推荐:DeepSeek(便宜、中文好)
OPENAI_BASE_URL=你的中转站base_url(例:https://apihub.agnes-ai.com/v1)
OPENAI_API_KEY=sk-你的key
CHAT_MODEL=你的模型名

# 调用层实现:langchain(默认,ChatOpenAI) | openai(改造前的裸 SDK)
# 出问题时改这一行即可回滚,不用改代码
LLM_BACKEND=langchain

# ===================== Redis(可选) =====================
# 已实测:本地 Redis 5.0.14.1(Windows 移植版)完全可用,
# 用到的命令(SETEX/GET/TTL/INCRBY/MGET/SET NX EX/RPUSH/LRANGE/LTRIM/EXPIRE/DEL)
# 都是 2.6 之前的基础命令,不需要为版本改代码。
# 验证脚本:python scripts/redis_compat_check.py
#
# 服务端建议(两条必须一起改,否则内存满后 SET 报 OOM 会触发缓存熔断):
#   redis-cli CONFIG SET maxmemory 256mb
#   redis-cli CONFIG SET maxmemory-policy allkeys-lru
#
# REDIS_ENABLED=false 可整体关闭缓存,应用退回直连 MySQL(功能不受影响)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_PREFIX=hb
# 熔断:连续失败 N 次后短路 M 秒
# REDIS_FAILURE_THRESHOLD=5
# REDIS_CIRCUIT_COOLDOWN=15

# 缓存 TTL(秒)
# CACHE_TTL_DASHBOARD=60
# CACHE_TTL_STATS=300
# CACHE_TTL_ACHIEVEMENTS=600
# CACHE_TTL_METRIC=300
# CACHE_TTL_INSIGHTS=1800

# ===================== RAG / ChromaDB =====================
CHROMA_DB_PATH=./chroma_db
RAG_COLLECTION=habit_knowledge
EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# 本地模型目录(留空则走 HF cache)
EMBED_LOCAL_DIR=
# 相似度阈值,0 = 不过滤(与改造前行为一致)
RAG_SCORE_THRESHOLD=0.0
# 设为 0 可关闭启动时的 RAG 预热
RAG_PRELOAD=1

# ===================== 观测 =====================
LOG_LEVEL=INFO
SLOW_REQUEST_MS=800

# ===================== 微信小程序(可选) =====================
# 真实微信登录需要
WX_APPID=your-wx-appid
WX_SECRET=your-wx-secret
